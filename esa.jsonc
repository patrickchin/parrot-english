{
  "name": "parrot-english",
  "installCommand": "npm ci && npm install --no-save --package-lock=false ffmpeg-static@5.3.0 ffprobe-static@3.1.0 && node scripts/prepare-esa-build.mjs",
  "buildCommand": "npm run build",
  "assets": {
    "directory": "./dist",
    "notFoundStrategy": "singlePageApplication"
  }
}
