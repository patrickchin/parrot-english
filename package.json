{
  "name": "parrotbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && node scripts/build-edge.mjs",
    "test": "npm run test:typecheck && npm run test:app && npm run test:content && npm run test:boundary",
    "test:browser": "playwright test",
    "test:stress": "playwright test --grep @stress",
    "test:all": "npm test && npm run test:browser",
    "content:validate": "node scripts/content.mjs validate",
    "content:stage": "node scripts/content.mjs stage",
    "content:publish": "node scripts/content.mjs publish",
    "content:remove": "node scripts/content.mjs remove",
    "test:typecheck": "tsc --noEmit",
    "test:app": "node --test tests/*.test.mjs",
    "test:content": "node --test tests/content/*.test.mjs",
    "test:boundary": "node --test tests/boundary/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "fuse.js": "7.5.0",
    "i18next": "27.1.1",
    "lucide-react": "1.64.0",
    "mediabunny": "1.65.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "18.0.1",
    "react-router": "7.18.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
