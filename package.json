{
  "name": "parrot-english",
  "version": "0.1.0",
  "description": "One-page English speaking practice lesson for young learners.",
  "keywords": [
    "english",
    "speaking-practice",
    "kids",
    "vite",
    "react"
  ],
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --port 3000",
    "predev:vite": "npm run check:content-catalogs",
    "dev:vite": "vite --host 0.0.0.0",
    "prebuild": "npm run check:content-catalogs && node scripts/prepare-workers-ci-metadata.mjs",
    "build": "tsc --noEmit && vite build",
    "build:agent": "tsc -p tsconfig.agent.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply parrot-english --local",
    "deploy:agent": "node scripts/deploy-livekit-agent.mjs",
    "predeploy:worker": "npm run check:content-catalogs",
    "deploy:worker": "node scripts/deploy-cloudflare-worker.mjs",
    "publish:backgrounds": "node scripts/publish-backgrounds.mjs",
    "publish:story-media": "node scripts/publish-story-media.mjs",
    "publish:static-media": "node scripts/publish-static-media.mjs",
    "verify:backgrounds": "node scripts/verify-background-media.mjs",
    "pregenerate:audio:elevenlabs": "npm run check:content-catalogs",
    "generate:audio:elevenlabs": "node scripts/generate-static-audio.mjs --provider=elevenlabs",
    "generate:rhyme-catalog": "node scripts/generate-rhyme-catalog.mjs",
    "check:rhyme-catalog": "node scripts/generate-rhyme-catalog.mjs --check",
    "generate:word-game-catalog": "node scripts/generate-word-game-catalog.mjs",
    "check:word-game-catalog": "node scripts/generate-word-game-catalog.mjs --check",
    "check:content-catalogs": "npm run check:rhyme-catalog && npm run check:word-game-catalog",
    "prestart": "npm run check:content-catalogs",
    "start": "wrangler dev --local --port 3000",
    "preview": "vite preview --host 0.0.0.0",
    "pretest:browser": "npm run check:content-catalogs",
    "test:browser": "playwright test",
    "pretest": "npm run check:content-catalogs",
    "test": "node --test tests/*.test.mjs tests/lifecycle/*.test.mjs",
    "test:conversation-safety": "node --test tests/conversation-safety-eval.test.mjs",
    "test:lifecycle": "node --test tests/lifecycle/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "@livekit/agents": "1.6.2",
    "@livekit/agents-plugin-openai": "1.6.2",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "livekit-client": "2.20.0",
    "livekit-server-sdk": "2.16.0",
    "lucide-react": "^1.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "^7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "happy-dom": "^20.10.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
