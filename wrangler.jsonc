{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parrot-english",
  "main": "worker/index.ts",
  "preview_urls": true,
  "routes": [
    { "pattern": "parrotbook.com", "custom_domain": true },
    { "pattern": "www.parrotbook.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "host": "localhost",
    "local_protocol": "http"
  },
  "vars": {
    "REALTIME_CONVERSATIONS_ENABLED": "1",
    "PERSONALIZED_STORY_ART_ENABLED": "1",
    "PERSONALIZED_STORY_ART_DATA_APPROVED": "1"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parrot-english",
      "database_id": "a034d27d-7125-4a8f-b4fc-c403610e9994",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "EVALUATE_RATE_LIMITER",
      "namespace_id": "104201",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "LEARNER_PROFILE_TRANSCRIPTION_RATE_LIMITER",
      "namespace_id": "104202",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "LEARNER_PROFILE_ENRICHMENT_RATE_LIMITER",
      "namespace_id": "104203",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "LESSON_GENERATION_RATE_LIMITER",
      "namespace_id": "104204",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "PERSONALIZED_STORY_ART_RATE_LIMITER",
      "namespace_id": "104205",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PERSONALIZED_STORY_ART_BUCKET",
      "bucket_name": "parrot-english-personalized-story-art",
      "preview_bucket_name": "parrot-english-personalized-story-art-preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
